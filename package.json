{
  "name": "chatmalik-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "ChatMALIK Android application build",
  "scripts": {
    "build:web": "node scripts/copy-web.mjs && esbuild scripts/native-voice-entry.js --bundle --format=iife --outfile=www/native-voice.js",
    "cap:sync": "npm run build:web && cap sync android",
    "android:debug": "npm run build:web && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capgo/capacitor-speech-recognition": "^8.6.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "capacitor-secure-storage-plugin": "^0.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.25.12",
    "sharp": "^0.34.5"
  }
}
